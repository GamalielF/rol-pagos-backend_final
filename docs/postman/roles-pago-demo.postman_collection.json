    {
      "key": "base",
      "value": "http://localhost:8080/api/v1/roles-pago"
    },
    {
      "key": "periodo",
      "value": "2026-09",
      "description": "yyyy-MM"
    },
    {
      "key": "usuarioAdmin",
      "value": "fsepa"
    },
    {
      "key": "usuarioRrhh",
      "value": "CAMBIAR_usuario_rrhh",
      "description": "Código AD de quien hará de RRHH"
    },
    {
      "key": "usuarioEmpleado",
      "value": "CAMBIAR_usuario_empleado",
      "description": "Código AD de quien hará de empleado"
    },
    {
      "key": "cedulaEmpleado",
      "value": "CAMBIAR_cedula_del_empleado"
    },
    {
      "key": "cedulaAjena",
      "value": "1712345675",
      "description": "Una cédula que NO es la del empleado"
    },
    {
      "key": "rolId",
      "value": "1",
      "description": "id de un rol del listado"
    },
    {
      "key": "token",
      "value": "",
      "description": "Solo si prueba con un token real"
    }
  ],
