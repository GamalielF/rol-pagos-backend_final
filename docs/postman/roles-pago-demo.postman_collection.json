              }
            ],
            "url": "{{base}}/actuator/health",
            "description": "Debe responder UP. No necesita sesión."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado esperado: 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
